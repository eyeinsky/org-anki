;;; org-anki-fields-test.el -*- lexical-binding: t; -*-
(require 'ert)
(require 'ox-html)
(require 'org-anki)

(defconst org-anki-test--json
  '((noteId . 42) (modelName . "Custom")
    (fields . ((Last (value . "") (order . 2))
               (First (value . "one") (order . 0))
               (Middle (value . "two") (order . 1))))))

(ert-deftest org-anki-import-uses-response-fields-without-requests ()
  (let ((org-anki-model-fields '(("Custom" "Wrong")))
        (org-anki-html-to-org #'identity))
    (cl-letf (((symbol-function 'org-anki-connect-request)
               (lambda (&rest _) (ert-fail "Unexpected request"))))
      (should (equal (org-anki--note-fields
                      (org-anki--parse-note org-anki-test--json "Deck"))
                     '(("First" . "one") ("Middle" . "two") ("Last" . "")))))))

(ert-deftest org-anki-model-fields-query-and-cache ()
  (let ((org-anki-model-fields nil)
        (org-anki--model-fields-cache (make-hash-table :test #'equal))
        (calls 0))
    (cl-letf (((symbol-function 'org-anki-connect-request)
               (lambda (body success _error &rest options)
                 (cl-incf calls)
                 (should (equal body '(("action" . "modelFieldNames")
                                       ("params" ("modelName" . "Custom")))))
                 (should (plist-get options :sync))
                 (funcall success ["Question" "Answer" "Third"]))))
      (dotimes (_ 2)
        (should (equal (org-anki--get-model-fields "Custom")
                       '("Question" "Answer" "Third"))))
      (should (= calls 1)))))

(ert-deftest org-anki-model-fields-propagates-api-error ()
  (let ((org-anki--model-fields-cache nil))
    (cl-letf (((symbol-function 'org-anki-connect-request)
               (lambda (_body _success failure &rest _)
                 (funcall failure "Model not found"))))
      (should-error (org-anki--get-model-fields "Missing")))))

(ert-deftest org-anki-field-overrides-do-not-query-anki ()
  (let ((org-anki-model-fields '(("Custom" "Local"))))
    (cl-letf (((symbol-function 'org-anki-connect-request)
               (lambda (&rest _) (ert-fail "Override must not query Anki"))))
      (should (equal (org-anki--get-model-fields "Custom") '("Local"))))))

(ert-deftest org-anki-sync-refreshes-model-cache ()
  (let ((org-anki-model-fields nil) (calls 0) collected)
    (cl-letf (((symbol-function 'org-anki-connect-request)
               (lambda (_body success _failure &rest _)
                 (cl-incf calls)
                 (funcall success ["Front" "Back"])))
              ((symbol-function 'org-anki--org-to-html) #'string-trim)
              ((symbol-function 'org-anki--sync-notes)
               (lambda (notes) (setq collected notes))))
      (with-temp-buffer
        (org-mode)
        (insert "#+ANKI_DECK: Deck\n* One\n:PROPERTIES:\n:ANKI_NOTE_ID: 1\n:END:\nAnswer\n* Two\n:PROPERTIES:\n:ANKI_NOTE_ID: 2\n:END:\nAnswer\n")
        (org-anki-sync-all)
        (should (= (length collected) 2))
        (should (= calls 1))
        (org-anki-update-all)
        (should (= (length collected) 2))
        (should (= calls 2))))))
